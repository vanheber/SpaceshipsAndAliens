# Credenciais FTP para deploy
FTP_HOST=ftp.exemplo.com
FTP_USER=usuario
FTP_PASSWORD=senha
FTP_PATH=/public_html/spaceships-and-aliens
FTP_PORT=21

# NOTA: Chaves de API agora são configuradas pelo usuário na interface
# (login.html → página "API Keys") e armazenadas no localStorage do navegador.
# Não é mais necessário configurar GEMINI_KEY, AUTH_PASSWORD, TOTP_SECRET
# ou NVIDIA_KEY no .env.
