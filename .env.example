# Credenciais FTP para deploy
FTP_HOST=ftp.exemplo.com
FTP_USER=usuario
FTP_PASSWORD=senha
FTP_PATH=/public_html/warp-unit
FTP_PORT=21

# Chaves de API (lidas pelo PHP via .env local — NÃO COMMITAR .env)
# Opcional: também podem ser setadas no .htaccess com SetEnv
GEMINI_KEY=AIza...
AUTH_PASSWORD=$2y$10$... (hash bcrypt da senha — gere com: php -r "echo password_hash('senha', PASSWORD_BCRYPT);")
TOTP_SECRET=JBSWY3DPEHPK3PXP (seed base32 do Google Authenticator)
